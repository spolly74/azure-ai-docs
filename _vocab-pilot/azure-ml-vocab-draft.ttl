  skos:scopeNote "Use for the YAML file format and its schemas. For the commands that use them, use Azure Machine Learning CLI extension."@en .

:compute a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "compute resource"@en ;
  skos:altLabel "compute target"@en ;
  skos:altLabel "compute"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :compute-instance ;
  skos:narrower :compute-cluster ;
  skos:narrower :dsvm ;
  skos:editorialNote "Pilot count: appears in 332 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:editorialNote "'compute target' is the older term. Confirm preferred label."@en ;
  skos:definition "A designated compute resource where you run a job or host an endpoint, such as a compute cluster, a compute instance, a Kubernetes cluster, or attached compute."@en ;
  skos:scopeNote "Use as the general term. Use the narrower concepts for specific types. 'compute target' is the older term; prefer this concept."@en .

:compute-instance a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "compute instance"@en ;
  skos:altLabel "notebook VM"@en ;
  skos:hiddenLabel "Compute Instance"@en ;
  skos:broader :compute ;
  skos:editorialNote "Pilot count: appears in 131 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:editorialNote "'notebook VM' is a retired name (1 article)."@en ;
  skos:definition "A fully managed, cloud-based workstation for developing and testing machine learning code."@en ;
  skos:scopeNote "Use for the single-user development workstation. For scalable training compute, use compute cluster."@en .

:compute-cluster a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "compute cluster"@en ;
  skos:altLabel "training cluster"@en ;
  skos:altLabel "AmlCompute"@en ;
  skos:hiddenLabel "Compute Cluster"@en ;
  skos:broader :compute ;
  skos:editorialNote "Pilot count: appears in 128 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A managed compute resource that creates a cluster of CPU or GPU nodes in the cloud, sized to the workload. You can share it with other users in the workspace."@en ;
  skos:scopeNote "Use for training and batch compute that scales out. For a single development machine, use compute instance."@en .

:dsvm a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "Data Science Virtual Machine"@en ;
  skos:altLabel "DSVM"@en ;
  skos:hiddenLabel "data science virtual machine"@en ;
  skos:broader :compute ;
  skos:editorialNote "Pilot count: appears in 31 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "An Azure virtual machine image preloaded with data science and machine learning tools. Unlike a compute instance, Azure Machine Learning doesn't manage it."@en ;
  skos:scopeNote "Use only for the virtual machine image. For a managed workstation, use compute instance."@en .

:data a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "data management"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :data-asset ;
  skos:narrower :dataset ;
  skos:narrower :datastore ;
  skos:narrower :feature-store ;
  skos:editorialNote "Grouping concept created for the pilot hierarchy."@en ;
  skos:definition "Grouping of the concepts for storing, referencing, and preparing data in Azure Machine Learning."@en ;
  skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .

:data-asset a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "data asset"@en ;
  skos:hiddenLabel "Data asset"@en ;
  skos:broader :data ;
  skos:related :dataset ;
  skos:editorialNote "Pilot count: appears in 86 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "An object registered in an Azure Machine Learning workspace that references data stored elsewhere, so jobs and users can access the data through the asset."@en ;
  skos:scopeNote "Use only for the registered workspace object. For data in general, use dataset. Avoid describing a data asset as a connection, because connection is a separate workspace object."@en ;
  skos:historyNote "In SDK v1 this object was called a dataset (Dataset, TabularDataset, and FileDataset classes). Some articles still say data assets were formerly known as datasets."@en .

:dataset a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "dataset"@en ;
  skos:broader :data ;
  skos:related :data-asset ;
  skos:editorialNote "Pilot count: appears in 226 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A collection of data used to train, evaluate, or run a model. A dataset can be registered in a workspace as a data asset."@en ;
  skos:scopeNote "Use for data in the general sense. For the registered workspace object, use data asset. For the SDK v1 Dataset classes, see the history note on data asset."@en .

:datastore a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "datastore"@en ;
  skos:altLabel "data store"@en ;
  skos:hiddenLabel "Datastore"@en ;
  skos:broader :data ;
  skos:editorialNote "Pilot count: appears in 117 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A reference to an existing Azure storage service that keeps the connection information, so scripts can reach the data without storing credentials in code."@en ;
  skos:scopeNote "Use for the stored connection to a storage service. For a reference to specific data, use data asset."@en .

:feature-store a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "feature store"@en ;
  skos:hiddenLabel "Feature Store"@en ;
  skos:broader :data ;
  skos:editorialNote "Pilot count: appears in 21 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A workspace type for creating, managing, and sharing machine learning features across multiple project workspaces."@en ;
  skos:scopeNote "Use for the managed feature store. Don't use for features in general."@en .

:job a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "job"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :training-job ;
  skos:narrower :pipeline-job ;
  skos:narrower :sweep-job ;
  skos:editorialNote "Pilot count: appears in 283 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A unit of work that Azure Machine Learning runs on compute, such as training a model, running a pipeline, or running a hyperparameter sweep. The workspace records each job's logs, metrics, and outputs."@en ;
  skos:scopeNote "Use as the general term. Use a narrower concept when the job type matters. 'run' and 'experiment' are SDK v1 terms."@en .

:training-job a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "training job"@en ;
  skos:altLabel "command job"@en ;
  skos:broader :job ;
  skos:editorialNote "Pilot count: appears in 107 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:editorialNote "'command job' added as a candidate alternate label; confirm."@en ;
  skos:definition "A job that runs a script to train a model. In SDK v2 and CLI v2, a training job is usually defined as a command job."@en ;
  skos:scopeNote "Use for single-step training. For multistep workflows, use pipeline job. For tuning runs, use sweep job."@en .

:pipeline-job a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "pipeline job"@en ;
  skos:altLabel "machine learning pipeline"@en ;
  skos:altLabel "pipeline"@en ;
  skos:hiddenLabel "pipeline-job"@en ;
  skos:broader :job ;
  skos:related :component ;
  skos:editorialNote "Pilot count: appears in 255 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A job that runs a machine learning pipeline: a workflow that connects components to complete a machine learning task."@en ;
  skos:scopeNote "Use for machine learning pipelines. Don't use for CI/CD pipelines in Azure DevOps or GitHub Actions."@en .

:sweep-job a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "sweep job"@en ;
  skos:broader :job ;
  skos:related :hpo ;
  skos:editorialNote "Pilot count: appears in 16 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A job that runs many trials of a training job, each with different hyperparameter values, and compares the results."@en ;
  skos:scopeNote "Use for the job type. For the general practice, use hyperparameter tuning."@en .

:hpo a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "hyperparameter tuning"@en ;
  skos:topConceptOf :scheme ;
  skos:related :sweep-job ;
  skos:editorialNote "Pilot count: appears in 22 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "The process of finding the hyperparameter values that give the best model performance."@en ;
  skos:scopeNote "Use for the practice. For the Azure Machine Learning job that does it, use sweep job."@en .

:automl a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "automated ML"@en ;
  skos:altLabel "AutoML"@en ;
  skos:altLabel "automated machine learning"@en ;
  skos:hiddenLabel "automated ml"@en ;
  skos:hiddenLabel "Automated ML"@en ;
  skos:topConceptOf :scheme ;
  skos:editorialNote "Pilot count: appears in 90 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:editorialNote "Preferred label assumes first-mention style 'automated ML (AutoML)'. Confirm."@en ;
  skos:definition "A capability in which Azure Machine Learning tries many algorithms and settings and selects the best model for your data and task."@en ;
  skos:scopeNote "Use 'automated ML (AutoML)' on first mention, then either form. The preferred label is still to be confirmed."@en .

:component a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "component"@en ;
  skos:topConceptOf :scheme ;
  skos:related :pipeline-job ;
  skos:editorialNote "Pilot count: appears in 229 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A self-contained piece of code that does one step in a machine learning pipeline, such as data processing, training, or scoring. It has a name and parameters, takes input, and returns output."@en ;
  skos:scopeNote "Use for pipeline building blocks. Don't use as a general word for parts of the product."@en .

:environment a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "environment"@en ;
  skos:topConceptOf :scheme ;
  skos:editorialNote "Pilot count: appears in 285 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A managed, versioned definition of the software packages, environment variables, and settings that a training or scoring script runs with."@en ;
  skos:scopeNote "Use for the Azure Machine Learning asset. Curated environments are provided by Azure Machine Learning; custom environments are defined by the user."@en .

:model a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "model"@en ;
  skos:altLabel "machine learning model"@en ;
  skos:altLabel "trained model"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :mlflow-model ;
  skos:editorialNote "Pilot count: appears in 435 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "The files that make up a trained machine learning model, plus their metadata. A registered model is tracked in the workspace by name and version."@en ;
  skos:scopeNote "Use for trained models and registered model assets. For the saved format, use the narrower concepts such as MLflow model."@en .

:mlflow-model a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "MLflow model"@en ;
  skos:hiddenLabel "MLFlow model"@en ;
  skos:hiddenLabel "Mlflow model"@en ;
  skos:broader :model ;
  skos:editorialNote "Pilot count: appears in 55 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A model saved in the MLflow format, which describes its files and how to load them. Azure Machine Learning can deploy an MLflow model without a scoring script or environment."@en ;
  skos:scopeNote "Use for models in MLflow format. Write MLflow with this capitalization."@en .

:endpoint a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "endpoint"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :online-endpoint ;
  skos:narrower :batch-endpoint ;
  skos:related :deployment ;
  skos:editorialNote "Pilot count: appears in 287 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A stable HTTPS address that clients call to get results from deployed models or pipelines. An endpoint can host one or more deployments."@en ;
  skos:scopeNote "Use as the general term. Use online endpoint or batch endpoint when the type matters. For the hosted model, use deployment."@en .

:online-endpoint a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "online endpoint"@en ;
  skos:altLabel "real-time endpoint"@en ;
  skos:hiddenLabel "online-endpoint"@en ;
  skos:broader :endpoint ;
  skos:narrower :managed-online-endpoint ;
  skos:related :online-deployment ;
  skos:editorialNote "Pilot count: appears in 163 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "An endpoint for real-time scoring that returns results in a synchronous request. Online endpoints can be managed or run on Kubernetes."@en ;
  skos:scopeNote "Use for real-time scoring. 'real-time endpoint' is an older name. For large-volume asynchronous scoring, use batch endpoint."@en .

:managed-online-endpoint a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "managed online endpoint"@en ;
  skos:hiddenLabel "Managed Online Endpoint"@en ;
  skos:broader :online-endpoint ;
  skos:editorialNote "Pilot count: appears in 91 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "An online endpoint whose serving infrastructure Azure Machine Learning provisions and manages. It's the recommended type of online endpoint."@en ;
  skos:scopeNote "Use when the managed type matters. For Kubernetes-based endpoints, say Kubernetes online endpoint."@en .

:batch-endpoint a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "batch endpoint"@en ;
  skos:hiddenLabel "Batch Endpoint"@en ;
  skos:broader :endpoint ;
  skos:editorialNote "Pilot count: appears in 72 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "An endpoint that scores large amounts of data asynchronously by running a batch job."@en ;
  skos:scopeNote "Use for asynchronous, large-volume scoring. For real-time requests, use online endpoint."@en .

:deployment a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "deployment"@en ;
  skos:altLabel "model deployment"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :online-deployment ;
  skos:related :endpoint ;
  skos:related :scoring-script ;
  skos:related :inference-server ;
  skos:editorialNote "Pilot count: appears in 246 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A set of resources and compute that hosts the model or pipeline that does the work behind an endpoint."@en ;
  skos:scopeNote "Use for what runs behind an endpoint. Don't use for the endpoint itself."@en .

:online-deployment a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "online deployment"@en ;
  skos:hiddenLabel "online-deployment"@en ;
  skos:broader :deployment ;
  skos:related :online-endpoint ;
  skos:editorialNote "Pilot count: appears in 50 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A deployment that serves an online endpoint. An online endpoint can split traffic across several online deployments."@en ;
  skos:scopeNote "Use for deployments under an online endpoint."@en .

:scoring-script a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "scoring script"@en ;
  skos:topConceptOf :scheme ;
  skos:related :deployment ;
  skos:editorialNote "Pilot count: appears in 55 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A Python script that loads a model and runs it on incoming data. It defines an init function and a run function."@en ;
  skos:scopeNote "Use for the user-written inference script. MLflow models don't need one."@en .

:inference-server a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "inference server"@en ;
  skos:altLabel "Azure Machine Learning inference HTTP server"@en ;
  skos:hiddenLabel "inference-server"@en ;
  skos:topConceptOf :scheme ;
  skos:related :deployment ;
  skos:editorialNote "Pilot count: appears in 13 of 670 articles in articles/machine-learning (any label)."@en ;
