:scheme a skos:ConceptScheme ;
  skos:prefLabel "Azure Machine Learning documentation vocabulary (pilot)"@en ;
  dct:created "2026-10-11" ;
  skos:editorialNote "Draft generated from term extraction of articles/machine-learning in azure-ai-docs. All concepts need review."@en ;
  skos:hasTopConcept :workspace, :studio, :prompt-flow, :dev-tools, :compute, :data, :job, :hpo, :automl, :component, :environment, :model, :endpoint, :deployment, :scoring-script, :inference-server, :security, :azure-deps, :ml-task, :rai .

:workspace a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "workspace"@en ;
  skos:altLabel "Azure Machine Learning workspace"@en ;
  skos:hiddenLabel "Workspace"@en ;
  skos:topConceptOf :scheme ;
  skos:related :azure-deps ;
  skos:editorialNote "Pilot count: appears in 388 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "The top-level resource for Azure Machine Learning. It provides a central place to work with the jobs, assets, and resources you create, and it keeps a history of all jobs."@en ;
  skos:scopeNote "Use for the Azure Machine Learning resource itself. For a feature store or hub, which are workspace types, use their own concepts where they exist."@en .

:studio a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "Azure Machine Learning studio"@en ;
  skos:altLabel "studio"@en ;
  skos:altLabel "studio UI"@en ;
  skos:altLabel "Machine Learning studio"@en ;
  skos:hiddenLabel "Azure Machine Learning Studio"@en ;
  skos:topConceptOf :scheme ;
  skos:narrower :designer ;
  skos:editorialNote "Pilot count: appears in 314 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "The web-based interface for Azure Machine Learning, used to manage a workspace and its jobs, assets, and compute."@en ;
  skos:scopeNote "Use for the browser interface. Don't use for the workspace it manages."@en .

:designer a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "designer"@en ;
  skos:altLabel "Azure Machine Learning designer"@en ;
  skos:altLabel "drag-and-drop designer"@en ;
  skos:hiddenLabel "Azure Machine Learning Designer"@en ;
  skos:broader :studio ;
  skos:editorialNote "Pilot count: appears in 124 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A drag-and-drop interface in Azure Machine Learning studio for building machine learning pipelines from components."@en ;
  skos:scopeNote "Use for the visual pipeline builder only. For pipelines built in code or YAML, use pipeline job."@en .

:prompt-flow a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "prompt flow"@en ;
  skos:hiddenLabel "Prompt Flow"@en ;
  skos:hiddenLabel "Prompt flow"@en ;
  skos:topConceptOf :scheme ;
  skos:editorialNote "Pilot count: appears in 67 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:editorialNote "Decide capitalization: 'prompt flow' (59 articles) vs 'Prompt flow/Prompt Flow' (42 articles)."@en ;
  skos:definition "A development tool in Azure Machine Learning for building, testing, and deploying applications that call large language models. A flow is a sequence of nodes that process input and produce output."@en ;
  skos:scopeNote "Use for the tool and for flows built with it. Capitalization is still to be decided."@en .

