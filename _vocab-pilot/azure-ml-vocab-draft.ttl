  skos:editorialNote "Pilot count: appears in 96 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A Microsoft Entra identity that Azure manages for a resource, so the resource can authenticate to other services without credentials in code."@en ;
  skos:scopeNote "Use as the general term. Use system-assigned or user-assigned when the type matters."@en .

:uami a skos:Concept ;
  skos:inScheme :scheme ;
  skos:prefLabel "user-assigned managed identity"@en ;
  skos:hiddenLabel "user assigned managed identity"@en ;
  skos:broader :managed-identity ;
