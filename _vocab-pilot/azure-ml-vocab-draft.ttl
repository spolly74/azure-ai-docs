  skos:broader :managed-identity ;
  skos:editorialNote "Pilot count: appears in 27 of 670 articles in articles/machine-learning (any label)."@en ;
  skos:definition "A managed identity created for one Azure resource. It's tied to that resource and is deleted with it."@en ;
  skos:scopeNote "Use when an article specifies this type. A workspace's system-assigned identity has the same name as the workspace."@en .

