PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX :     <https://vocab.example.org/azure-ml/>

# Adds a definition and scope note to every concept except data asset and dataset,
# which already have them. Writes into the project graph.

INSERT DATA { GRAPH <https://vocab.example.org/azure-ml/> {
  :workspace skos:definition "The top-level resource for Azure Machine Learning. It provides a central place to work with the jobs, assets, and resources you create, and it keeps a history of all jobs."@en ;
      skos:scopeNote "Use for the Azure Machine Learning resource itself. For a feature store or hub, which are workspace types, use their own concepts where they exist."@en .
  :studio skos:definition "The web-based interface for Azure Machine Learning, used to manage a workspace and its jobs, assets, and compute."@en ;
      skos:scopeNote "Use for the browser interface. Don't use for the workspace it manages."@en .
  :designer skos:definition "A drag-and-drop interface in Azure Machine Learning studio for building machine learning pipelines from components."@en ;
      skos:scopeNote "Use for the visual pipeline builder only. For pipelines built in code or YAML, use pipeline job."@en .
  :prompt-flow skos:definition "A development tool in Azure Machine Learning for building, testing, and deploying applications that call large language models. A flow is a sequence of nodes that process input and produce output."@en ;
      skos:scopeNote "Use for the tool and for flows built with it. Capitalization is still to be decided."@en .
  :dev-tools skos:definition "Grouping of the command-line tools, SDKs, editors, and APIs used to work with Azure Machine Learning."@en ;
      skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .
  :azure-cli skos:definition "The cross-platform command-line tool for managing Azure resources."@en ;
      skos:scopeNote "Use for the base Azure CLI. For the Azure Machine Learning commands, use Azure Machine Learning CLI extension."@en .
  :ml-cli skos:definition "The ml extension to the Azure CLI, which adds commands for Azure Machine Learning workspaces, jobs, and assets. Also called CLI v2."@en ;
      skos:scopeNote "Use for CLI v2 commands. Don't use for the base Azure CLI or for the retired v1 CLI extension."@en .
  :python-sdk skos:definition "The Python library for working with Azure Machine Learning from code."@en ;
      skos:scopeNote "Use when the version doesn't matter. When it does, use Python SDK v2 or Python SDK v1."@en .
  :sdk-v2 skos:definition "The current version of the Azure Machine Learning Python SDK, provided by the azure-ai-ml package. It works with the same assets and jobs as CLI v2."@en ;
      skos:scopeNote "Use for current Python guidance. Prefer this concept over the general Python SDK concept when an article shows code."@en .
  :sdk-v1 skos:definition "The earlier version of the Azure Machine Learning Python SDK, provided by the azureml-core package. SDK v2 replaces it."@en ;
      skos:scopeNote "Use only in migration and legacy content. Don't use for new guidance."@en .
  :vs-code skos:definition "A code editor from Microsoft. With the Azure Machine Learning extension, you can manage workspace resources and run jobs from the editor."@en ;
      skos:scopeNote "Use for the editor and its Azure Machine Learning extension. The preferred label is still to be decided."@en .
  :rest-api skos:definition "The HTTP interface for creating and managing Azure Machine Learning resources, jobs, and assets."@en ;
      skos:scopeNote "Use for direct REST calls. For calls to a deployed model, use endpoint."@en .
  :yaml-schema skos:definition "The published schemas that define the structure of the YAML files CLI v2 uses to describe jobs, assets, endpoints, and compute."@en ;
      skos:scopeNote "Use for the YAML file format and its schemas. For the commands that use them, use Azure Machine Learning CLI extension."@en .
  :compute skos:definition "A designated compute resource where you run a job or host an endpoint, such as a compute cluster, a compute instance, a Kubernetes cluster, or attached compute."@en ;
      skos:scopeNote "Use as the general term. Use the narrower concepts for specific types. 'compute target' is the older term; prefer this concept."@en .
  :compute-instance skos:definition "A fully managed, cloud-based workstation for developing and testing machine learning code."@en ;
      skos:scopeNote "Use for the single-user development workstation. For scalable training compute, use compute cluster."@en .
  :compute-cluster skos:definition "A managed compute resource that creates a cluster of CPU or GPU nodes in the cloud, sized to the workload. You can share it with other users in the workspace."@en ;
      skos:scopeNote "Use for training and batch compute that scales out. For a single development machine, use compute instance."@en .
  :dsvm skos:definition "An Azure virtual machine image preloaded with data science and machine learning tools. Unlike a compute instance, Azure Machine Learning doesn't manage it."@en ;
      skos:scopeNote "Use only for the virtual machine image. For a managed workstation, use compute instance."@en .
  :data skos:definition "Grouping of the concepts for storing, referencing, and preparing data in Azure Machine Learning."@en ;
      skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .
  :datastore skos:definition "A reference to an existing Azure storage service that keeps the connection information, so scripts can reach the data without storing credentials in code."@en ;
      skos:scopeNote "Use for the stored connection to a storage service. For a reference to specific data, use data asset."@en .
  :feature-store skos:definition "A workspace type for creating, managing, and sharing machine learning features across multiple project workspaces."@en ;
      skos:scopeNote "Use for the managed feature store. Don't use for features in general."@en .
  :job skos:definition "A unit of work that Azure Machine Learning runs on compute, such as training a model, running a pipeline, or running a hyperparameter sweep. The workspace records each job's logs, metrics, and outputs."@en ;
      skos:scopeNote "Use as the general term. Use a narrower concept when the job type matters. 'run' and 'experiment' are SDK v1 terms."@en .
  :training-job skos:definition "A job that runs a script to train a model. In SDK v2 and CLI v2, a training job is usually defined as a command job."@en ;
      skos:scopeNote "Use for single-step training. For multistep workflows, use pipeline job. For tuning runs, use sweep job."@en .
  :pipeline-job skos:definition "A job that runs a machine learning pipeline: a workflow that connects components to complete a machine learning task."@en ;
      skos:scopeNote "Use for machine learning pipelines. Don't use for CI/CD pipelines in Azure DevOps or GitHub Actions."@en .
  :sweep-job skos:definition "A job that runs many trials of a training job, each with different hyperparameter values, and compares the results."@en ;
      skos:scopeNote "Use for the job type. For the general practice, use hyperparameter tuning."@en .
  :hpo skos:definition "The process of finding the hyperparameter values that give the best model performance."@en ;
      skos:scopeNote "Use for the practice. For the Azure Machine Learning job that does it, use sweep job."@en .
  :automl skos:definition "A capability in which Azure Machine Learning tries many algorithms and settings and selects the best model for your data and task."@en ;
      skos:scopeNote "Use 'automated ML (AutoML)' on first mention, then either form. The preferred label is still to be confirmed."@en .
  :component skos:definition "A self-contained piece of code that does one step in a machine learning pipeline, such as data processing, training, or scoring. It has a name and parameters, takes input, and returns output."@en ;
      skos:scopeNote "Use for pipeline building blocks. Don't use as a general word for parts of the product."@en .
  :environment skos:definition "A managed, versioned definition of the software packages, environment variables, and settings that a training or scoring script runs with."@en ;
      skos:scopeNote "Use for the Azure Machine Learning asset. Curated environments are provided by Azure Machine Learning; custom environments are defined by the user."@en .
  :model skos:definition "The files that make up a trained machine learning model, plus their metadata. A registered model is tracked in the workspace by name and version."@en ;
      skos:scopeNote "Use for trained models and registered model assets. For the saved format, use the narrower concepts such as MLflow model."@en .
  :mlflow-model skos:definition "A model saved in the MLflow format, which describes its files and how to load them. Azure Machine Learning can deploy an MLflow model without a scoring script or environment."@en ;
      skos:scopeNote "Use for models in MLflow format. Write MLflow with this capitalization."@en .
  :endpoint skos:definition "A stable HTTPS address that clients call to get results from deployed models or pipelines. An endpoint can host one or more deployments."@en ;
      skos:scopeNote "Use as the general term. Use online endpoint or batch endpoint when the type matters. For the hosted model, use deployment."@en .
  :online-endpoint skos:definition "An endpoint for real-time scoring that returns results in a synchronous request. Online endpoints can be managed or run on Kubernetes."@en ;
      skos:scopeNote "Use for real-time scoring. 'real-time endpoint' is an older name. For large-volume asynchronous scoring, use batch endpoint."@en .
  :managed-online-endpoint skos:definition "An online endpoint whose serving infrastructure Azure Machine Learning provisions and manages. It's the recommended type of online endpoint."@en ;
      skos:scopeNote "Use when the managed type matters. For Kubernetes-based endpoints, say Kubernetes online endpoint."@en .
  :batch-endpoint skos:definition "An endpoint that scores large amounts of data asynchronously by running a batch job."@en ;
      skos:scopeNote "Use for asynchronous, large-volume scoring. For real-time requests, use online endpoint."@en .
  :deployment skos:definition "A set of resources and compute that hosts the model or pipeline that does the work behind an endpoint."@en ;
      skos:scopeNote "Use for what runs behind an endpoint. Don't use for the endpoint itself."@en .
  :online-deployment skos:definition "A deployment that serves an online endpoint. An online endpoint can split traffic across several online deployments."@en ;
      skos:scopeNote "Use for deployments under an online endpoint."@en .
  :scoring-script skos:definition "A Python script that loads a model and runs it on incoming data. It defines an init function and a run function."@en ;
      skos:scopeNote "Use for the user-written inference script. MLflow models don't need one."@en .
  :inference-server skos:definition "The Azure Machine Learning inference HTTP server, a Python package that exposes a scoring function as a local HTTP endpoint for testing and debugging."@en ;
      skos:scopeNote "Use for this package. Don't use for other servers, such as Triton Inference Server."@en .
  :security skos:definition "Grouping of the concepts for identity, network access, and encryption."@en ;
      skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .
  :managed-identity skos:definition "A Microsoft Entra identity that Azure manages for a resource, so the resource can authenticate to other services without credentials in code."@en ;
      skos:scopeNote "Use as the general term. Use system-assigned or user-assigned when the type matters."@en .
  :uami skos:definition "A managed identity that exists as its own Azure resource. You can assign it to one or more resources, and it remains when they're deleted."@en ;
      skos:scopeNote "Use when an article specifies this type."@en .
  :sami skos:definition "A managed identity created for one Azure resource. It's tied to that resource and is deleted with it."@en ;
      skos:scopeNote "Use when an article specifies this type. A workspace's system-assigned identity has the same name as the workspace."@en .
  :service-principal skos:definition "A Microsoft Entra identity for an application or automated process, used to authenticate without user interaction."@en ;
      skos:scopeNote "Use for app identities that you create and manage. For identities Azure manages for you, use managed identity."@en .
  :entra-id skos:definition "The Microsoft cloud identity service. It's the identity provider for Azure Machine Learning."@en ;
      skos:scopeNote "Use this name. 'Azure Active Directory' and 'Azure AD' are former names; use them only when needed for clarity."@en .
  :network-isolation skos:definition "Restricting network access to a workspace and its associated resources so that traffic uses private networks instead of the public internet."@en ;
      skos:scopeNote "Use as the general term. Use virtual network, managed virtual network, or private endpoint for specific mechanisms."@en .
  :vnet skos:definition "An Azure Virtual Network: a private network in Azure that you create and control."@en ;
      skos:scopeNote "Use for customer-created virtual networks. For the network Azure Machine Learning creates, use workspace managed virtual network."@en .
  :managed-vnet skos:definition "A virtual network that Azure Machine Learning creates and manages for a workspace, to isolate its managed compute and control outbound traffic."@en ;
      skos:scopeNote "Use for the network Azure Machine Learning manages. For a network you create, use virtual network."@en .
  :private-endpoint skos:definition "A network interface with private IP addresses in your virtual network that connects privately to an Azure service, such as a workspace or storage account."@en ;
      skos:scopeNote "Use for this Azure networking feature. Don't use for online or batch endpoints."@en .
  :cmk skos:definition "An encryption key that you create and manage in Azure Key Vault, used instead of a Microsoft-managed key to encrypt workspace data."@en ;
      skos:scopeNote "Use when the customer controls the key. Write 'customer-managed key' with a hyphen."@en .
  :azure-deps skos:definition "Grouping of the Azure resources that a workspace uses, such as storage, a key vault, a container registry, and Application Insights."@en ;
      skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .
  :storage-account skos:definition "An Azure Storage account. Each workspace has a default storage account for files such as job outputs and logs."@en ;
      skos:scopeNote "Use for the Azure resource. For the registered connection to it, use datastore."@en .
  :key-vault skos:definition "An Azure service that stores secrets and cryptographic keys. Each workspace uses a key vault for secrets such as credentials and connection strings."@en ;
      skos:scopeNote "Use for the Azure resource."@en .
  :acr skos:definition "An Azure service that stores container images. A workspace uses it for the Docker images built for environments."@en ;
      skos:scopeNote "Use for the Azure resource."@en .
  :app-insights skos:definition "An Azure Monitor feature that collects application telemetry. A workspace can use it to monitor deployed endpoints."@en ;
      skos:scopeNote "Use for the Azure resource."@en .
  :ml-task skos:definition "Grouping of the kinds of problems a model can be trained to solve."@en ;
      skos:scopeNote "Grouping concept for the pilot hierarchy. Not a product term; don't tag articles with it or use it in prose."@en .
  :image-classification skos:definition "A computer vision task that assigns one or more labels to an entire image."@en ;
      skos:scopeNote "Use for whole-image labeling. For locating objects within an image, use object detection."@en .
  :object-detection skos:definition "A computer vision task that finds objects in an image, marking each one with a label and a bounding box."@en ;
      skos:scopeNote "Use for locating objects. For labeling the whole image, use image classification."@en .
  :forecasting skos:definition "A task that predicts future values of a variable from its past values over time."@en ;
      skos:scopeNote "Use 'time-series forecasting' with a hyphen. 'forecasting' alone is acceptable when the context is clear."@en .
  :multilabel skos:definition "A classification task in which each item can have more than one label."@en ;
      skos:scopeNote "Use when an item can belong to several classes. When each item has exactly one class, say multiclass classification."@en .
  :rai skos:definition "The practice of building AI systems that are fair, reliable and safe, private and secure, inclusive, transparent, and accountable. In Azure Machine Learning, it includes tools such as the Responsible AI dashboard."@en ;
      skos:scopeNote "Capitalize as Responsible AI when referring to the practice or the tools."@en .
} }
