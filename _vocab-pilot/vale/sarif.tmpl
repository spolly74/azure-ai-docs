{{- /* SARIF 2.1.0 output for Vale. Usage: vale --output=<path to this file> <files> > vale.sarif */ -}}
{{- $rules := dict -}}
{{- range .Files -}}{{- range .Alerts -}}{{- $_ := set $rules .Check . -}}{{- end -}}{{- end -}}
{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [{
    "tool": { "driver": {
      "name": "Vale",
      "informationUri": "https://vale.sh",
      "rules": [
        {{- $first := true -}}
        {{- range $id, $a := $rules -}}
        {{- if not $first }},{{ end }}{{ $first = false }}
        { "id": {{ $id | toJson }}, "shortDescription": { "text": {{ $id | toJson }} }{{ if $a.Link }}, "helpUri": {{ $a.Link | toJson }}{{ end }} }
        {{- end }}
      ]
    } },
    "results": [
      {{- $firstR := true -}}
      {{- range $f := .Files -}}{{- range $a := $f.Alerts -}}
      {{- if not $firstR }},{{ end }}{{ $firstR = false }}
      {
        "ruleId": {{ $a.Check | toJson }},
        "level": {{ if eq $a.Severity "error" }}"error"{{ else if eq $a.Severity "warning" }}"warning"{{ else }}"note"{{ end }},
        "message": { "text": {{ $a.Message | toJson }} },
        "locations": [{ "physicalLocation": {
          "artifactLocation": { "uri": {{ $f.Path | toJson }} },
          "region": { "startLine": {{ $a.Line }}, "startColumn": {{ index $a.Span 0 }}, "endColumn": {{ add (index $a.Span 1) 1 }}, "snippet": { "text": {{ $a.Match | toJson }} } }
        } }]
      }
      {{- end -}}{{- end }}
    ]
  }]
}
